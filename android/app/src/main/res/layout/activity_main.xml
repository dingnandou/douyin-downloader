<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="粘贴抖音分享内容，解析并保存视频或图文"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="在抖音点「分享 → 复制链接」，粘贴到这里"
            android:minHeight="96dp"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="#5A5A68"
            android:textSize="15sp"
            android:inputType="textMultiLine"
            android:importantForAutofill="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/parseButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="解析作品"
            android:textSize="16sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_red"
            app:cornerRadius="14dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:indeterminateTint="@color/brand_cyan"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/coverImage"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="封面"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/authorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="保存视频"
                android:textColor="@color/bg"
                android:textSize="15sp"
                android:visibility="gone"
                app:backgroundTint="@color/brand_cyan"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bundleButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="保存全部图片"
                android:textColor="@color/bg"
                android:textSize="15sp"
                android:visibility="gone"
                app:backgroundTint="@color/brand_cyan"
                app:cornerRadius="12dp" />

            <GridLayout
                android:id="@+id/imageGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:orientation="horizontal" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="仅供个人学习与存档，请尊重作者版权，勿二次分发"
            android:textColor="#55555F"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

    <!-- 隐藏的解析用 WebView：正常尺寸渲染，但整体移出屏幕 -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="360dp"
        android:layout_height="640dp"
        android:layout_gravity="top|start"
        android:translationX="-2000dp"
        android:translationY="-2000dp" />

</FrameLayout>
